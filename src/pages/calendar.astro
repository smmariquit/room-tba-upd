---
import AppRoot from "@ui/AppRoot.svelte";
import Layout from "@layouts/Layout.astro";
import {
  breadcrumbSchema,
  jsonLd,
  ogCardPath,
  webpageSchema,
  websiteSchema,
} from "@lib/site";

// Deep link to the academic calendar viewer: /calendar?term=<crs_id>.
// Entry.svelte opens the screen on this path (#408). Not /terms — that is the
// Terms of Service page.
const title = "Academic Calendar | Room TBA";
const description =
  "See where today falls in the UP Diliman academic year: instructional windows per CRS term, the in-session term, and class counts.";
const structuredData = jsonLd(
  websiteSchema(),
  webpageSchema({ title, description, path: "/calendar" }),
  breadcrumbSchema([
    { name: "Home", path: "/" },
    { name: "Academic Calendar", path: "/calendar" },
  ]),
);
---

<Layout
  title={title}
  description={description}
  canonicalPath="/calendar"
  imagePath={ogCardPath({
    title: "Academic Calendar",
    subtitle: "UP Diliman term windows on a year timeline",
    kicker: "Calendar",
  })}
  structuredData={structuredData}
>
  <AppRoot
    client:only="svelte"
    openCalendar={true}
    suppressLandingModal={true}
  />
</Layout>
